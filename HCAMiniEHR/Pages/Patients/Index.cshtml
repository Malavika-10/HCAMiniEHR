@page
@model HCAMiniEHR.Pages.Patients.IndexModel
@{
    ViewData["Title"] = "Patients";
}

<h3 class="mb-4">Patients</h3>

<div class="card p-4">

    <div class="d-flex justify-content-between mb-3">
        <h5>Patient Records</h5>
        <a asp-page="/Patients/Create" class="btn btn-primary">
            <i class="bi bi-plus-circle"></i> Add Patient
        </a>
    </div>

    <table class="table table-bordered table-hover">
        <thead class="table-light">
            <tr>
                <th>#</th>
                <th>Full Name</th>
                <th>Gender</th>
                <th>Date of Birth</th>
                <th>Phone</th>
                <th style="width:120px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @if (Model.Patients != null && Model.Patients.Any())
            {
                foreach (var patient in Model.Patients)
                {
                    <tr>
                        <td>@patient.PatientId</td>
                        <td>@patient.FullName</td>
                        <td>@patient.Gender</td>
                        <td>@patient.DateOfBirth.ToString("dd-MM-yyyy")</td>
                        <td>@patient.Phone</td>
                        <td>
                            <a asp-page="/Patients/Edit"
                               asp-route-id="@patient.PatientId"
                               class="btn btn-sm btn-warning">
                                <i class="bi bi-pencil"></i>
                            </a>

                            <a asp-page="/Patients/Delete"
                               asp-route-id="@patient.PatientId"
                               class="btn btn-sm btn-danger"
                               onclick="return confirm('Are you sure you want to delete this patient?');">
                                <i class="bi bi-trash"></i>
                            </a>
                        </td>
                    </tr>
                }
            }
            else
            {
                <tr>
                    <td colspan="6" class="text-center text-muted">
                        No patient records found.
                    </td>
                </tr>
            }
        </tbody>
    </table>

</div>
