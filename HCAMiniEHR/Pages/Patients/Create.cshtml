@page
@model HCAMiniEHR.Pages.Patients.CreateModel
@{
    ViewData["Title"] = "Add Patient";
}

<h3 class="mb-4">Add New Patient</h3>

<div class="card p-4">

    <!-- IMPORTANT: method="post" -->
    <form method="post">
        @if (!ViewData.ModelState.IsValid && ViewData.ModelState.Count > 0)
        {
            <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>
        }


        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Full Name</label>
                <input asp-for="Patient.FullName" class="form-control" placeholder="Enter full name" />
                <span asp-validation-for="Patient.FullName" class="text-danger"></span>

            </div>

            <div class="col-md-6">
                <label class="form-label">Gender</label>
                <select asp-for="Patient.Gender" class="form-select">
                    <option value="">-- Select --</option>
                    <option>Male</option>
                    <option>Female</option>
                </select>
                <span asp-validation-for="Patient.Gender" class="text-danger"></span>
            </div>
        </div>

        <div class="row mb-3">
            <div class="col-md-6">
                <label class="form-label">Date of Birth</label>
                <input asp-for="Patient.DateOfBirth" type="date" class="form-control" />
                <span asp-validation-for="Patient.DateOfBirth" class="text-danger"></span>
            </div>

            <div class="col-md-6">
                <label class="form-label">Phone</label>
                <input asp-for="Patient.Phone" class="form-control" placeholder="Enter phone number" />
                <span asp-validation-for="Patient.Phone" class="text-danger"></span>
            </div>
        </div>

        <div class="d-flex justify-content-end">
            <a asp-page="/Patients/Index" class="btn btn-secondary me-2">
                Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                Save Patient
            </button>
        </div>

    </form>

</div>
@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
