@page
@model HCAMiniEHR.Pages.Appointments.CreateModel
@{
    ViewData["Title"] = "Add Appointment";
}

<h3 class="mb-4">Add Appointment</h3>

<div class="card p-4">

    <form method="post">

        <!-- Patient -->
        <div class="mb-3">
            <label class="form-label">Patient</label>
            <select asp-for="PatientId"
                    asp-items="Model.PatientList"
                    class="form-select">
                <option value="">-- Select Patient --</option>
            </select>
            <span asp-validation-for="PatientId" class="text-danger"></span>
        </div>

        <!-- Doctor -->
        <div class="mb-3">
            <label class="form-label">Doctor</label>
            <select asp-for="DoctorId"
                    asp-items="Model.DoctorList"
                    class="form-select">
                <option value="">-- Select Doctor --</option>
            </select>
            <span asp-validation-for="DoctorId" class="text-danger"></span>
        </div>

        <!-- Appointment Date -->
        <div class="mb-3">
            <label class="form-label">Appointment Date</label>
            <input asp-for="AppointmentDate"
                   type="datetime-local"
                   class="form-control"
                   min="@DateTime.Now.ToString("yyyy-MM-ddTHH:mm")" />
            <span asp-validation-for="AppointmentDate" class="text-danger"></span>
        </div>

        <!-- Status -->
        <div class="mb-3">
            <label class="form-label">Status</label>
            <select asp-for="Status" class="form-select">
                <option value="Pending">Pending</option>
                <option value="Confirmed">Confirmed</option>
            </select>
            <span asp-validation-for="Status" class="text-danger"></span>
        </div>

        <div class="d-flex justify-content-end">
            <a asp-page="/Appointments/Index"
               class="btn btn-secondary me-2">
                Cancel
            </a>
            <button type="submit" class="btn btn-primary">
                Save Appointment
            </button>
        </div>

    </form>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
